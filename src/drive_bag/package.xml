<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drive_bag</name>
  <version>0.1.0</version>
  <description>Convert logged vehicle drive data (RPM, speed, pressure) into a rosbag2 MCAP file, replay it, and compute drive KPIs.</description>
  <maintainer email="michealswolski@users.noreply.github.com">Micheal Swolski</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>
  <!-- mcap_to_bag also needs the pip package mcap (see Dockerfile) -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
