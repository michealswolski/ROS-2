<?xml version='1.0' encoding='UTF-8'?>
<root>
 <tabbed_widget name="Main Window" parent="main_window">
  <Tab containers="1" tab_name="Drive">
   <Container>
    <DockSplitter count="3" orientation="-" sizes="0.333333;0.333333;0.333333">
     <DockArea name="Engine RPM">
      <plot style="Lines" mode="TimeSeries" flip_x="false" flip_y="false">
       <range bottom="500" top="3500" left="0" right="280"/>
       <limitY/>
       <curve name="/vehicle/rpm/data" color="#2a78d6"/>
      </plot>
     </DockArea>
     <DockArea name="Speed [km/h]">
      <plot style="Lines" mode="TimeSeries" flip_x="false" flip_y="false">
       <range bottom="0" top="125" left="0" right="280"/>
       <limitY/>
       <curve name="/vehicle/speed/data" color="#eb6834"/>
      </plot>
     </DockArea>
     <DockArea name="Pressure [kPa]">
      <plot style="Lines" mode="TimeSeries" flip_x="false" flip_y="false">
       <range bottom="150" top="400" left="0" right="280"/>
       <limitY/>
       <curve name="/vehicle/pressure/data" color="#1baf7a"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
 <Plugins>
  <plugin ID="DataLoad MCAP"/>
  <plugin ID="ROS2 Topic Subscriber">
   <selected_topics>
    <topic name="/vehicle/rpm"/>
    <topic name="/vehicle/speed"/>
    <topic name="/vehicle/pressure"/>
   </selected_topics>
  </plugin>
 </Plugins>
 <previouslyLoaded_Datafiles/>
 <customMathEquations/>
 <snippets/>
</root>
